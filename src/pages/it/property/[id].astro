---
import AstroLayout from "../../../layouts/AstroLayout.astro";
import Page, { generateMetadata } from "../../../app/it/property/[id]/page";
import { getSeo, metadataToSeo, SITE_URL } from "@/data/seo";

const params = Promise.resolve({ id: Astro.params.id ?? "" });
const id = Astro.params.id ?? "";
const metadata = await generateMetadata({ params });
const seo = metadataToSeo(metadata, {
  ...getSeo("/it/listing_06"),
  title: "Proprieta in vendita o affitto | Cervantes Immobiliare",
  canonical: `${SITE_URL}/it/property/${id}`,
});
---

<AstroLayout {...seo}>
  <Page params={params} />
</AstroLayout>
