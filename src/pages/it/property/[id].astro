---
import AstroLayout from "../../../layouts/AstroLayout.astro";
import Page, { generateMetadata, fetchProperty } from "../../../app/it/property/[id]/page";
import ImageGallery from "@/components/common/ImageGallery";
import SiteChrome from "@/components/astro/SiteChrome";
import { getSeo, metadataToSeo, SITE_URL } from "@/data/seo";

const params = Promise.resolve({ id: Astro.params.id ?? "" });
const id = Astro.params.id ?? "";
const property = await fetchProperty(id);
if (!property) {
  return new Response("Propiedad no encontrada", { status: 404 });
}
const metadata = await generateMetadata({ params });
const seo = metadataToSeo(metadata, {
  ...getSeo("/it/listing_06"),
  title: "Proprieta in vendita o affitto | Cervantes Immobiliare",
  canonical: `${SITE_URL}/it/property/${id}`,
});
---

<AstroLayout {...seo}>
  <Page property={property}>
    <ImageGallery client:load images={property.property_images ?? []} title={property.title} />
  </Page>
  <SiteChrome client:load />
</AstroLayout>
