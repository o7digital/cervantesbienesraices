---
export const prerender = true;
import AstroLayout from "../../../layouts/AstroLayout.astro";
import SiteChrome from "../../../components/astro/SiteChrome";
import Wrapper from "@/layouts/Wrapper";
import HeaderFive from "@/layouts/headers/HeaderFive";
import Footer from "@/layouts/footers/FooterThreeDe";
import ListingArea from "@/components/inner-listing/listing-06-de/ListingSixAreaDe";
import { getSeo } from "@/data/seo";
const seo = getSeo("/de/listing_06");
---

<AstroLayout {...seo}>
  <Wrapper>
    <div class="main-page-wrapper">
      <HeaderFive style="dark" />
      <ListingArea client:load />
      <Footer />
    </div>
  </Wrapper>
  <SiteChrome client:load />
</AstroLayout>
