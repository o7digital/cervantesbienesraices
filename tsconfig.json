{
  "compilerOptions": {
    "target": "es2015",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./public/assets/*"],
      "next/link": ["./src/astro-shims/next-link.tsx"],
      "next/image": ["./src/astro-shims/next-image.tsx"],
      "next/navigation": ["./src/astro-shims/next-navigation.ts"],
      "next/script": ["./src/astro-shims/next-script.tsx"]
    }
  },
  "include": [".astro/types.d.ts", "src/**/*.ts", "src/**/*.tsx", "src/**/*.astro"],
  "exclude": ["node_modules", "crm-suites-o7-main"]
}
