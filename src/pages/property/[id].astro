---
import AstroLayout from "../../layouts/AstroLayout.astro";
import Page, { generateMetadata } from "../../app/property/[id]/page";
import { getSeo, metadataToSeo, SITE_URL } from "@/data/seo";

const params = { id: Astro.params.id ?? "" };
const metadata = await generateMetadata({ params });
const seo = metadataToSeo(metadata, {
  ...getSeo("/listing_06"),
  title: "Propiedad en venta o renta | Cervantes Bienes Raíces",
  canonical: `${SITE_URL}/property/${params.id}`,
});
---

<AstroLayout {...seo}>
  <Page params={params} />
</AstroLayout>
